# Development values for the compose stack (docker compose up -d). Copy to .env, or let
# `hoc model load` merge the missing keys into .env. Never use these outside a workstation.
HOC_POSTGRES_DSN=postgresql://hoc:hoc@localhost:5433/hoc
HOC_OPENFGA_URL=http://localhost:8080
HOC_OIDC_ISSUER=http://localhost:8180/realms/acme
HOC_OIDC_AUDIENCE=headofcontext
HOC_OIDC_CLIENT_ID=headofcontext
HOC_OIDC_CLIENT_SECRET=hoc-dev-secret
HOC_ALLOW_EPHEMERAL_ROOT_KEY=true
HOC_CONNECTORS_REQUIRED=false
# Written by `hoc model load`:
# HOC_OPENFGA_STORE_ID=
# HOC_OPENFGA_MODEL_ID=
